<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/install-service.sh reemplaza @LABEL@, @APP_EXE@ y @LOG@ y lo instala en
     ~/Library/LaunchAgents/@LABEL@.plist. Lanza el ejecutable de Dictado.app: el launcher queda
     como proceso responsable ante TCC y los permisos son de la app, no del python del venv. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@APP_EXE@</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <!-- Se relanza SÓLO si muere por una señal de crash (el launcher re-emite la señal del hijo).
       Una salida con código (config inválida, atajo ocupado, "Salir" del menú) no se relanza. -->
  <key>KeepAlive</key>
  <dict>
    <key>Crashed</key>
    <true/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>@LOG@</string>
  <key>StandardErrorPath</key>
  <string>@LOG@</string>
</dict>
</plist>
